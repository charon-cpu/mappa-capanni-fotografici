---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StepsComeFunziona from '../components/StepsComeFunziona.astro';
import AnteprimaItalia from '../components/AnteprimaItalia.astro';
import { SITE } from '../config/site';

const tuttiLuoghi = await getCollection('luoghi');
const numeroLuoghi = tuttiLuoghi.length;
const regioniPubblicate = [...new Set(tuttiLuoghi.map((l) => l.data.regione))];
const numeroRegioni = regioniPubblicate.length;

// Tutte le regioni italiane: quelle non ancora pubblicate compaiono come
// "in arrivo" (mai come già coperte — nessun dato promesso che non abbiamo).
const tutteLeRegioni = [
  'Valle d\'Aosta',
  'Piemonte',
  'Liguria',
  'Lombardia',
  'Trentino-Alto Adige',
  'Veneto',
  'Friuli Venezia Giulia',
  'Emilia-Romagna',
  'Toscana',
  'Umbria',
  'Marche',
  'Lazio',
  'Abruzzo',
  'Molise',
  'Campania',
  'Puglia',
  'Basilicata',
  'Calabria',
  'Sicilia',
  'Sardegna',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.tagline,
  url: Astro.site,
};
---

<Base
  title={`${SITE.name} — capanni fotografici e oasi naturalistiche in Italia`}
  description={`Mappa gratuita e senza registrazione di capanni fotografici e oasi naturalistiche in Italia, verificata a mano sulle fonti ufficiali. Oggi ${numeroLuoghi} schede in ${numeroRegioni} regione (Veneto), in crescita.`}
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1>Trova il tuo prossimo capanno fotografico</h1>
    <p>
      La mappa dei capanni fotografici e delle oasi naturalistiche in Italia,
      pensata per fotografi naturalisti italiani. Gratuita e senza
      registrazione.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/mappa">Apri la mappa</a>
      <a class="btn btn-secondary" href="#come-funziona">Come funziona</a>
    </div>
    <span class="hero-photo-credit">Foto segnaposto — da sostituire con una foto naturalistica reale</span>
  </section>

  <section class="section" id="come-funziona">
    <h2>Come funziona</h2>
    <p class="section-lead">Tre passi, senza login e senza sorprese.</p>
    <StepsComeFunziona />
  </section>

  <section class="section">
    <h2>{numeroLuoghi} luoghi verificati, si parte dal Veneto</h2>
    <p class="section-lead">
      Il sito cresce regione per regione: pubblichiamo solo quello che
      abbiamo controllato di persona sulle fonti ufficiali.
    </p>
    <AnteprimaItalia numeroLuoghi={numeroLuoghi} />
  </section>

  <section class="section">
    <h2>Perché fidarsi</h2>
    <div class="trust-grid">
      <div class="trust-item">
        <h3>Fonti ufficiali</h3>
        <p>Ogni scheda nasce da un sito di un ente o gestore ufficiale (WWF, LIPU, parchi, comuni), mai copiata da altri siti.</p>
      </div>
      <div class="trust-item">
        <h3>Data di ultima verifica</h3>
        <p>Capanni e oasi cambiano prezzi e orari: ogni scheda dice quando è stata controllata l'ultima volta.</p>
      </div>
      <div class="trust-item">
        <h3>Prudenza con la fauna</h3>
        <p>Per i siti più delicati (nidi, specie sensibili) non mostriamo coordinate precise, solo l'area o il comune.</p>
      </div>
      <div class="trust-item">
        <h3>Revisione manuale</h3>
        <p>Ogni segnalazione di un nuovo luogo o di una correzione viene controllata a mano prima di essere pubblicata.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Regioni disponibili e in arrivo</h2>
    <p class="section-lead">
      Copriamo oggi solo il Veneto. Le altre regioni sono in lavorazione,
      una alla volta: non ci sono ancora schede pubblicate per loro.
    </p>
    <div class="region-list">
      {tutteLeRegioni.map((regione) => {
        const disponibile = regioniPubblicate.includes(regione);
        return disponibile ? (
          <a class="region-chip" data-available="true" href={`/regione/veneto`}>{regione}</a>
        ) : (
          <span class="region-chip" data-available="false">{regione} · in arrivo</span>
        );
      })}
    </div>
  </section>

  <section class="section cta-band">
    <h2>Conosci un capanno o un'oasi che manca?</h2>
    <p class="section-lead" style="margin-left:auto;margin-right:auto">
      Chiunque può segnalare un luogo nuovo o una correzione: revisioniamo
      ogni segnalazione a mano prima di pubblicarla.
    </p>
    <a class="btn btn-primary" href="/segnala">Segnala un luogo</a>
  </section>
</Base>
