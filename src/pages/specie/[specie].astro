---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LuogoCard from '../../components/LuogoCard.astro';
import { slugify } from '../../utils/slug';

export async function getStaticPaths() {
  const luoghi = await getCollection('luoghi');
  const specieMap = new Map<string, string>();
  for (const l of luoghi) {
    for (const s of l.data.specie_principali) {
      specieMap.set(slugify(s), s);
    }
  }
  return [...specieMap.entries()].map(([slug, nomeSpecie]) => ({
    params: { specie: slug },
    props: {
      nomeSpecie,
      luoghi: luoghi
        .filter((l) => l.data.specie_principali.includes(nomeSpecie))
        .map((l) => ({ ...l.data, url: `/${slugify(l.data.regione)}/${l.data.id}` })),
    },
  }));
}

const { nomeSpecie, luoghi } = Astro.props;
---

<Base
  title={`Dove fotografare: ${nomeSpecie} | Mappa dei Capanni Fotografici`}
  description={`Capanni fotografici e oasi naturalistiche dove è possibile osservare o fotografare: ${nomeSpecie}.`}
>
  <p><a href="/">&larr; Torna alla mappa</a></p>
  <h1>Dove osservare: {nomeSpecie}</h1>
  <p>{luoghi.length} luoghi verificati dove è segnalata questa specie.</p>

  <div class="card-grid">
    {luoghi.map((l) => (
      <LuogoCard
        id={l.id}
        nome={l.nome}
        tipo={l.tipo}
        comune={l.comune}
        provincia={l.provincia}
        regione={l.regione}
        prenotazione_necessaria={l.prenotazione_necessaria}
        url={l.url}
      />
    ))}
  </div>
</Base>
