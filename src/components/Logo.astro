---
// Logo applicato: martin pescatore stilizzato, variante 4 da
// /design/logo-varianti/. Le varianti precedenti (cavaliere d'Italia,
// 3 stili) restano in quella cartella se si vuole tornare indietro: per
// cambiare, sostituisci il markup qui sotto con il contenuto di un altro
// file .svg (stessa struttura, un solo punto da toccare).
interface Props {
  class?: string;
}
const { class: className = 'logo-mark' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Martin pescatore stilizzato, logo del sito"
>
  <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M 6 50 L 58 50" opacity="0.55" />
  <path fill="currentColor" d="M 48 32 L 58 27 L 58 39 Z" />
  <ellipse cx="35" cy="35" rx="17" ry="14" fill="currentColor" />
  <circle cx="19" cy="23" r="14" fill="currentColor" />
  <path fill="currentColor" d="M 8 20 L 8 27 L 26 24 Z" />
  <circle cx="20.5" cy="21" r="1.6" fill="var(--logo-eye, #fff)" />
  <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
    <path d="M 29 48 L 29 50" />
    <path d="M 40 48 L 40 50" />
  </g>
</svg>
