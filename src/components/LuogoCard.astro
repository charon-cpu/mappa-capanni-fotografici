---
import FotoLuogo from './FotoLuogo.astro';

interface Props {
  id: string;
  nome: string;
  tipo: string;
  comune: string;
  provincia: string;
  regione: string;
  prenotazione_necessaria: boolean | null;
  url: string;
  immagine?: any;
}

const { id, nome, tipo, comune, provincia, url, prenotazione_necessaria, immagine } = Astro.props;

const etichetteTipo: Record<string, string> = {
  capanno_fotografico: 'Capanno fotografico',
  osservatorio_birdwatching: 'Osservatorio birdwatching',
  oasi_riserva: 'Oasi / riserva',
};
---

<article class="luogo-card" id={`card-${id}`}>
  <a href={url} tabindex="-1" aria-hidden="true">
    <FotoLuogo immagine={immagine} nome={nome} variant="card" />
  </a>
  <span class={`badge tipo-${tipo}`}>{etichetteTipo[tipo] ?? tipo}</span>
  <h3><a href={url}>{nome}</a></h3>
  <p class="meta">{comune} ({provincia})</p>
  <p class="meta">{prenotazione_necessaria === null ? 'Prenotazione: da verificare' : prenotazione_necessaria ? 'Prenotazione necessaria' : 'Accesso libero'}</p>
</article>
