---
// Sagoma dell'Italia semplificata e originale (disegno mio, non tracciata da
// dataset geografici — vedi REPORT.md per il perché e per come sostituirla
// con un contorno geografico preciso in futuro). I pin animati rappresentano
// le schede pubblicate in Veneto.
interface Props {
  numeroLuoghi: number;
}
const { numeroLuoghi } = Astro.props;
---

<div class="italy-preview" id="anteprima-italia">
  <svg viewBox="0 0 200 300" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={`Sagoma stilizzata dell'Italia con ${numeroLuoghi} punti in Veneto`}>
    <path
      fill="var(--color-border)"
      d="M 85 15 L 105 12 L 122 20 L 116 28 L 128 34 L 142 40 L 136 48 L 142 58 L 138 70 L 132 82 L 136 96 L 130 112 L 134 128 L 128 145 L 132 160 L 140 172 L 152 182 L 168 190 L 178 202 L 170 212 L 156 210 L 148 220 L 152 232 L 144 240 L 130 236 L 122 246 L 112 258 L 104 272 L 96 268 L 100 254 L 92 246 L 86 232 L 90 218 L 80 208 L 76 192 L 82 178 L 74 164 L 78 148 L 70 134 L 74 118 L 66 104 L 70 88 L 64 72 L 70 56 L 66 40 L 74 26 Z"
    />
    <path fill="var(--color-border)" d="M 108 280 L 122 276 L 130 284 L 124 294 L 110 292 Z" />
    <path fill="var(--color-border)" d="M 40 150 L 50 148 L 54 170 L 48 200 L 38 198 L 34 172 Z" />

    <!-- pin del Veneto, compaiono uno alla volta -->
    <circle class="preview-pin" cx="150" cy="178" r="4" fill="var(--color-accent)" style="transition-delay:0.1s" />
    <circle class="preview-pin" cx="160" cy="188" r="4" fill="var(--color-accent)" style="transition-delay:0.35s" />
    <circle class="preview-pin" cx="142" cy="192" r="4" fill="var(--color-accent)" style="transition-delay:0.6s" />
    <circle class="preview-pin" cx="155" cy="200" r="4" fill="var(--color-accent)" style="transition-delay:0.85s" />
  </svg>
  <p class="section-lead" style="text-align:center">
    {numeroLuoghi} luoghi verificati in Veneto, la prima regione pubblicata.
  </p>
</div>

<script>
  const el = document.getElementById('anteprima-italia');
  if (el && 'IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.3 }
    );
    obs.observe(el);
  } else if (el) {
    el.classList.add('is-visible');
  }
</script>
