---
import 'leaflet/dist/leaflet.css';

interface LuogoMappa {
  id: string;
  nome: string;
  tipo: string;
  regione: string;
  comune: string;
  specie: string[];
  prenotazione: boolean;
  lat: number;
  lon: number;
  url: string;
}

interface Props {
  luoghi: LuogoMappa[];
}

const { luoghi } = Astro.props;
---

<div id="map" role="application" aria-label="Mappa dei capanni fotografici e delle oasi"></div>
<script type="application/json" id="luoghi-data" set:html={JSON.stringify(luoghi)} />

<script>
  import L from 'leaflet';
  import iconUrl from 'leaflet/dist/images/marker-icon.png';
  import iconRetinaUrl from 'leaflet/dist/images/marker-icon-2x.png';
  import shadowUrl from 'leaflet/dist/images/marker-shadow.png';

  const defaultIcon = L.icon({
    iconUrl,
    iconRetinaUrl,
    shadowUrl,
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34],
    shadowSize: [41, 41],
  });

  // Un solo colore d'accento (coerente col resto del sito): le tipologie si
  // distinguono per intensità dello stesso colore, non per tinte diverse.
  const sfondoTipo: Record<string, string> = {
    capanno_fotografico: 'var(--color-accent)',
    osservatorio_birdwatching:
      'color-mix(in srgb, var(--color-accent) 55%, var(--color-text) 45%)',
    oasi_riserva: 'var(--color-text-muted)',
  };

  function coloredIcon(tipo: string) {
    const colore = sfondoTipo[tipo] ?? 'var(--color-text-muted)';
    // L'area cliccabile (24x24, soglia minima per i bersagli touch) è più
    // grande del pallino visibile (16x16): centrato con flex, non cambia
    // l'aspetto della mappa ma allarga la zona toccabile.
    return L.divIcon({
      className: 'marker-dot',
      html: `<span style="display:flex;align-items:center;justify-content:center;width:24px;height:24px;"><span style="display:block;width:16px;height:16px;border-radius:50%;background:${colore};border:2px solid var(--color-bg);box-shadow:0 0 0 1px rgba(0,0,0,0.25);"></span></span>`,
      iconSize: [24, 24],
      iconAnchor: [12, 12],
      popupAnchor: [0, -12],
    });
  }

  const dataEl = document.getElementById('luoghi-data');
  const luoghi = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const map = L.map('map', { scrollWheelZoom: false });

  // Inquadra tutti i luoghi pubblicati invece di un centro fisso: con più
  // regioni pubblicate una vista fissa sul Veneto lascerebbe fuori le altre.
  if (luoghi.length > 0) {
    const bounds = L.latLngBounds(luoghi.map((l: any) => [l.lat, l.lon]));
    map.fitBounds(bounds, { padding: [24, 24] });
  } else {
    map.setView([42.5, 12.5], 6);
  }

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 18,
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  }).addTo(map);

  const markers: { luogo: any; marker: L.Marker }[] = [];

  for (const luogo of luoghi) {
    const marker = L.marker([luogo.lat, luogo.lon], {
      icon: coloredIcon(luogo.tipo),
      alt: luogo.nome,
    })
      .addTo(map)
      .bindPopup(
        `<strong><a href="${luogo.url}">${luogo.nome}</a></strong><br>${luogo.comune}`
      );
    // Leaflet rende i marker con bindPopup interattivi (role="button",
    // tabindex) ma senza nome accessibile: lo aggiungiamo a mano.
    marker.getElement()?.setAttribute('aria-label', `${luogo.nome}, ${luogo.comune}`);
    markers.push({ luogo, marker });
  }

  function applyFilters() {
    const regioneSel = document.getElementById('filtro-regione') as HTMLSelectElement | null;
    const tipoSel = document.getElementById('filtro-tipo') as HTMLSelectElement | null;
    const specieSel = document.getElementById('filtro-specie') as HTMLSelectElement | null;
    const prenotazioneSel = document.getElementById('filtro-prenotazione') as HTMLSelectElement | null;

    const regione = regioneSel?.value ?? '';
    const tipo = tipoSel?.value ?? '';
    const specie = specieSel?.value ?? '';
    const prenotazione = prenotazioneSel?.value ?? '';

    for (const { luogo, marker } of markers) {
      const matchRegione = !regione || luogo.regione === regione;
      const matchTipo = !tipo || luogo.tipo === tipo;
      const matchSpecie = !specie || luogo.specie.includes(specie);
      const matchPrenotazione =
        !prenotazione || String(luogo.prenotazione) === prenotazione;

      const visibile = matchRegione && matchTipo && matchSpecie && matchPrenotazione;

      const el = document.getElementById(`card-${luogo.id}`);
      if (el) el.style.display = visibile ? '' : 'none';

      if (visibile) {
        if (!map.hasLayer(marker)) marker.addTo(map);
      } else {
        if (map.hasLayer(marker)) map.removeLayer(marker);
      }
    }
  }

  document
    .querySelectorAll('#filtro-regione, #filtro-tipo, #filtro-specie, #filtro-prenotazione')
    .forEach((el) => el.addEventListener('change', applyFilters));
</script>
